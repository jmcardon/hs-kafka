cabal-version: 2.4
name:          kafka
version:       0.2
license:       BSD-3-Clause
license-file:  LICENSE
author:        Ethan Jones, Jose Cardona
build-type:    Simple
extra-source-files: CHANGELOG.md

library
  exposed-modules:
    Kafka.Client
    Kafka.Common
    Kafka.Consumer
    Kafka.Producer

    Kafka.Internal.ApiVersions.Request
    Kafka.Internal.ApiVersions.Response
    Kafka.Internal.Broker
    Kafka.Internal.Combinator
    Kafka.Internal.Compression
    Kafka.Internal.Config
    Kafka.Internal.FindCoordinator.Request
    Kafka.Internal.FindCoordinator.Response
    Kafka.Internal.Fetch.Request
    Kafka.Internal.Fetch.Response
    Kafka.Internal.Heartbeat.Request
    Kafka.Internal.InitProducerId.Request
    Kafka.Internal.InitProducerId.Response
    Kafka.Internal.Heartbeat.Response
    Kafka.Internal.JoinGroup.Request
    Kafka.Internal.JoinGroup.Response
    Kafka.Internal.LeaveGroup.Request
    Kafka.Internal.LeaveGroup.Response
    Kafka.Internal.ListOffsets.Request
    Kafka.Internal.ListOffsets.Response
    Kafka.Internal.Metadata.Request
    Kafka.Internal.Metadata.Response
    Kafka.Internal.OffsetCommit.Request
    Kafka.Internal.OffsetCommit.Response
    Kafka.Internal.OffsetFetch.Request
    Kafka.Internal.OffsetFetch.Response
    Kafka.Internal.Produce.Request
    Kafka.Internal.Produce.Response
    Kafka.Internal.Reconnect
    Kafka.Internal.Request
    Kafka.Internal.Request.Types
    Kafka.Internal.Response
    Kafka.Internal.ShowDebug
    Kafka.Internal.SyncGroup.Request
    Kafka.Internal.SyncGroup.Response
    Kafka.Internal.Topic
    Kafka.Internal.Writer
    Kafka.Internal.Zigzag
  -- Prelude: using base's standard Prelude
  ghc-options:
    -Wall
    -O2
  build-depends:
    , base              >= 4.16
    , byteslice         >= 0.2
    , bytesmith         >= 0.3
    , bytestring        >= 0.11
    , castagnoli        >= 0.2
    , containers        >= 0.6
    , contiguous        >= 0.5
    , mtl               >= 2.2
    , network           >= 3.1
    , primitive          >= 0.9
    , primitive-unlifted >= 0.1
    , proto3-wire       >= 1.4
    , stm               >= 2.5
    , transformers      >= 0.5
  hs-source-dirs:
    src
  default-language:
    GHC2024

test-suite unit
  type:             exitcode-stdio-1.0
  main-is:          UnitTests.hs
  hs-source-dirs:   test
  build-depends:
    , base
    , bytesmith
    , bytestring
    , containers
    , kafka
    , primitive
    , primitive-unlifted
    , tasty
    , tasty-golden
    , tasty-hunit
  default-language: GHC2024
  ghc-options:      -Wall -O2

test-suite integration
  type:             exitcode-stdio-1.0
  main-is:          IntegrationTests.hs
  other-modules:    MockCluster
  hs-source-dirs:   test
  build-depends:
    , base
    , bytestring
    , kafka
    , network
    , primitive
    , stm
    , tasty
    , tasty-hunit
  extra-libraries:  rdkafka
  if os(darwin)
    extra-lib-dirs:   /opt/homebrew/lib
    include-dirs:     /opt/homebrew/include
  if os(linux)
    extra-lib-dirs:   /usr/lib /usr/lib/x86_64-linux-gnu /usr/lib/aarch64-linux-gnu
    include-dirs:     /usr/include /usr/include/librdkafka
  default-language: GHC2024
  ghc-options:      -Wall -O2 -threaded
